# --- LLM: LiteLLM (preferred) with Groq fallback. Nothing else is used. ---

# Valura LiteLLM proxy (OpenAI-compatible)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm-infra.valura.ai
LITELLM_MODEL=valura/claude-haiku-4-5-20251001
# Set to 0 to force Groq even if LITELLM_API_KEY is set
USE_LITELLM=1

# Groq fallback: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Phase 2+ Postgres (docker compose up db)
DATABASE_URL=postgresql+psycopg://ai:ai@localhost:5532/ai

# Data sources (no keys needed): DuckDuckGo for web search, Yahoo Finance for market data.

# Phase 8: Slack (optional). The server runs without them; Slack turns on when both are set.
# See docs/slack_setup.md.
# SLACK_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# SLACK_STREAMING=1     # 0 = send one message at the end instead of live typing

# Phase 3 embeddings: local FastEmbed (no key needed).
