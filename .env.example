# --- LLM: LiteLLM (preferred) with Groq fallback. Nothing else is used. ---

# Valura LiteLLM proxy (OpenAI-compatible)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm-infra.valura.ai
# Primary model: smart (best quality).
# Fallback option: cheap (lowest cost) or coding.
LITELLM_MODEL=smart
# Set to 0 to force Groq even if LITELLM_API_KEY is set
USE_LITELLM=1

# Groq fallback: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Phase 2+ Postgres (docker compose up db)
DATABASE_URL=postgresql+psycopg://ai:ai@localhost:5532/ai

# Data sources (no keys needed): DuckDuckGo for web search, Yahoo Finance for market data.

# Phase 8: Slack (optional). The server runs without them; Slack turns on when both are set.
# See docs/slack_setup.md.
# SLACK_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# SLACK_STREAMING=1     # 0 = send one message at the end instead of live typing

# Phase 9: morning briefing schedule (06:00 per user timezone). Slack DM needs SLACK_TOKEN
# plus a Slack member id on each user entry (third field).
# MORNING_BRIEFING_USERS=demo@valura.dev:Asia/Kolkata:U01ABC,alice@valura.dev:America/New_York
# MORNING_BRIEFING_TZ=UTC
# PORT=8000
# SCHEDULER_BASE_URL=http://127.0.0.1:8000
# SCHEDULER_POLL_INTERVAL=15

# Phase 11: production auth + optional separate trace DB
# RUNTIME_ENV=dev          # set to prd to require JWTs
# FORCE_JWT=0
# JWT_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----...
# TRACE_DATABASE_URL=postgresql+psycopg://ai:ai@localhost:5533/ai

# Phase 3 embeddings: local FastEmbed (no key needed).
